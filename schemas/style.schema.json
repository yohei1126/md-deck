{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yohei1126/md-deck/schemas/style.schema.json",
  "title": "md-deck style front matter tokens",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "color_background",
    "color_text",
    "color_title",
    "font_family",
    "font_size_body"
  ],
  "properties": {
    "page_width": { "$ref": "#/$defs/size" },
    "page_height": { "$ref": "#/$defs/size" },
    "color_background": { "$ref": "#/$defs/color" },
    "color_text": { "$ref": "#/$defs/color" },
    "color_muted": { "$ref": "#/$defs/color" },
    "color_gray": { "$ref": "#/$defs/color" },
    "color_border": { "$ref": "#/$defs/color" },
    "color_title": { "$ref": "#/$defs/color" },
    "color_top_bar": { "$ref": "#/$defs/color" },
    "color_accent_2": { "$ref": "#/$defs/color" },
    "color_highlight": { "$ref": "#/$defs/color" },
    "color_highlight_bg": { "$ref": "#/$defs/color" },
    "color_key_message_bg": { "$ref": "#/$defs/color" },
    "color_key_message_text": { "$ref": "#/$defs/color" },
    "color_key_message_border": { "$ref": "#/$defs/color" },
    "color_question_bg": { "$ref": "#/$defs/color" },
    "color_question_text": { "$ref": "#/$defs/color" },
    "color_question_border": { "$ref": "#/$defs/color" },
    "color_card_bg": { "$ref": "#/$defs/color" },
    "color_card_border": { "$ref": "#/$defs/color" },
    "color_flow_node_bg": { "$ref": "#/$defs/color" },
    "color_flow_node_border": { "$ref": "#/$defs/color" },
    "color_flow_arrow": { "$ref": "#/$defs/color" },
    "color_table_header_bg": { "$ref": "#/$defs/color" },
    "color_table_border": { "$ref": "#/$defs/color" },
    "font_family": { "type": "string", "minLength": 1 },
    "font_size_body": { "$ref": "#/$defs/size" },
    "font_size_title": { "$ref": "#/$defs/size" },
    "font_size_key_message": { "$ref": "#/$defs/size" },
    "font_size_question": { "$ref": "#/$defs/size" },
    "font_size_small": { "$ref": "#/$defs/size" },
    "font_size_table": { "$ref": "#/$defs/size" },
    "font_weight_title": { "$ref": "#/$defs/fontWeight" },
    "font_weight_body": { "$ref": "#/$defs/fontWeight" },
    "source_label_weight": { "$ref": "#/$defs/fontWeight" },
    "source_label_gap": { "$ref": "#/$defs/sizeOrNone" },
    "line_height": { "$ref": "#/$defs/lineHeight" },
    "page_padding": { "$ref": "#/$defs/sizeOrNone" },
    "page_padding_top": { "$ref": "#/$defs/sizeOrNone" },
    "page_padding_right": { "$ref": "#/$defs/sizeOrNone" },
    "page_padding_bottom": { "$ref": "#/$defs/sizeOrNone" },
    "page_padding_left": { "$ref": "#/$defs/sizeOrNone" },
    "footer_inset_bottom": { "$ref": "#/$defs/signedSizeOrNone" },
    "footer_inset_right": { "$ref": "#/$defs/signedSizeOrNone" },
    "gap": { "$ref": "#/$defs/sizeOrNone" },
    "flow_callout_gap": { "$ref": "#/$defs/sizeOrNone" },
    "flow_port_gap": { "$ref": "#/$defs/sizeOrNone" },
    "flow_edge_shape": {
      "type": "string",
      "enum": ["orthogonal", "straight"]
    },
    "card_radius": { "$ref": "#/$defs/sizeOrNone" },
    "card_padding": { "$ref": "#/$defs/sizeOrNone" },
    "key_message_radius": { "$ref": "#/$defs/sizeOrNone" },
    "question_radius": { "$ref": "#/$defs/sizeOrNone" },
    "border_width": { "$ref": "#/$defs/sizeOrNone" },
    "flow_node_min_width": { "$ref": "#/$defs/sizeOrNone" },
    "flow_node_max_width": { "$ref": "#/$defs/sizeOrNone" },
    "flow_node_min_height": { "$ref": "#/$defs/sizeOrNone" },
    "column_min_height": { "$ref": "#/$defs/sizeOrNone" },
    "flow_node_padding": { "$ref": "#/$defs/sizeOrNone" },
    "label_question": { "type": "string", "minLength": 1 },
    "label_key_message": { "type": "string", "minLength": 1 },
    "label_source": {
      "type": "string",
      "description": "Footer source prefix. Empty string hides it. Defaults follow lang when omitted."
    },
    "question_label_placement": {
      "type": "string",
      "enum": ["inline", "block"]
    },
    "page_number_placement": {
      "type": "string",
      "enum": ["bottom-right", "bottom-left", "bottom-center"]
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "minLength": 1,
      "description": "CSS colour: #rgb, #rrggbb, #rrggbbaa, rgb(), rgba(), hsl(), hsla(), or a named colour."
    },
    "size": {
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(px|rem|em|%)$"
        }
      ]
    },
    "sizeOrNone": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        {
          "type": "string",
          "pattern": "^(none|[0-9]+(\\.[0-9]+)?(px|rem|em|%))$"
        }
      ],
      "description": "Non-negative size, or the keyword none (useful for radius and border_width)."
    },
    "signedSizeOrNone": {
      "oneOf": [
        { "type": "number" },
        {
          "type": "string",
          "pattern": "^(none|-?[0-9]+(\\.[0-9]+)?(px|rem|em|%))$"
        }
      ],
      "description": "Signed size (negative allowed for footer insets), or the keyword none."
    },
    "fontWeight": {
      "oneOf": [
        { "type": "integer", "minimum": 100, "maximum": 900 },
        {
          "type": "string",
          "enum": ["normal", "bold", "bolder", "lighter"]
        }
      ]
    },
    "lineHeight": {
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(px|rem|em|%)?$"
        }
      ]
    }
  }
}
